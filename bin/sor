#!/usr/bin/env python3
"""sor — yerel Ollama'ya soru sor, DUZ METIN cevap al.

## Neden bu var

Ollama'nin HTTP API'si varsayilan olarak **token basina bir JSON satiri**
akitir:

    {"model":"llama3.2","response":"Mer","done":false}
    {"model":"llama3.2","response":"hab","done":false}

`curl` ile soru soran herkes once bunu gorur ve "model bana JSON donuyor"
sanir. Model yanlis bir sey yapmiyor; istemci akisi birlestirmiyor.
Bu arac o birlestirmeyi yapar ve ekrana yalnizca metni yazar.

## Kullanim

    sor "2 + 2 kac eder"
    sor -m kod "bu fonksiyonu python'a cevir: ..."
    sor -g sprite.png "bu gorselde kac karakter var"
    cat hata.log | sor "bu hatanin sebebi ne"
    sor --modeller

Modeller (kisayol -> gercek ad):

    hizli  llama3.2         2 GB   kisa sorular
    kod    qwen2.5-coder    4.7 GB kod
    goz    qwen2.5vl        6 GB   GORSEL okur (-g ile)
    buyuk  gpt-oss:20b      14 GB  en yetenekli, en yavas

## Tasarim notlari

- Servis kapaliysa KENDISI baslatir. "could not connect" hatasi kullanicinin
  cozmesi gereken bir sey degil; arac zaten nerede oldugunu biliyor.
- Cikti AKAR: 20B model ilk kelimeyi saniyeler icinde verir, tamamini
  dakikalarca yazar. Beklerken bos ekran gormek "calismiyor" gibi hissettirir.
- Gorsel base64'e cevrilip `images` alaninda gonderilir; yalniz goren model
  (qwen2.5vl) bunu kullanabilir, oteki modeller sessizce gormezden gelir —
  o yuzden -g verildiginde model otomatik `goz`e gecer.
"""
from __future__ import annotations

import argparse
import base64
import json
import os
import subprocess
import sys
import time
import urllib.error
import urllib.request

# Windows'ta cikti cp857'ye dusuyor ve Turkce karakterler bozuluyor; boruya
# yazarken UnicodeEncodeError bile verebiliyor. Bu tuzaga bugun uc ayri yerde
# yakalandik — burada kaynaginda kapatiyoruz.
for _akis in (sys.stdout, sys.stderr):
    if hasattr(_akis, "reconfigure"):
        _akis.reconfigure(encoding="utf-8", errors="replace")


def _sunucu() -> str:
    """OLLAMA_HOST'u kullanilabilir bir URL'e cevir.

    Ollama'nin KENDI konvansiyonu semasiz: bu makinede
    `OLLAMA_HOST=127.0.0.1:11434` yazili. Onu oldugu gibi kullanirsak URL
    `127.0.0.1:11434/api/tags` olur; urllib bunu ayristiramaz, istisna atar
    ve arac servisi KAPALI saniyor — nitekim sandi. curl ayni anda 200
    donuyordu, yani "ag sorunu" degil, semasiz host sorunuydu.
    """
    h = (os.environ.get("OLLAMA_HOST") or "").strip()
    if not h:
        return "http://127.0.0.1:11434"
    if not h.startswith(("http://", "https://")):
        h = "http://" + h
    return h.rstrip("/")


SUNUCU = _sunucu()

KISAYOL = {
    "hizli": "llama3.2:latest",
    "kod": "qwen2.5-coder:7b",
    "goz": "qwen2.5vl:7b",
    "buyuk": "gpt-oss:20b",
}
VARSAYILAN = "kod"


def _istek(yol: str, govde: dict | None = None, zaman: float = 10.0):
    veri = json.dumps(govde).encode() if govde is not None else None
    r = urllib.request.Request(f"{SUNUCU}{yol}", data=veri,
                               headers={"Content-Type": "application/json"})
    return urllib.request.urlopen(r, timeout=zaman)


def ayakta_mi() -> bool:
    try:
        _istek("/api/tags", zaman=3).read()
        return True
    except Exception:  # noqa: BLE001 - kapali olmasi normal bir cevap
        return False


def baslat() -> bool:
    """Servisi baslat. Kullanicinin elle baslatmasi gereken bir sey degil."""
    if ayakta_mi():
        return True
    exe = None
    for aday in (r"M:\Ollama\ollama.exe", "ollama"):
        if aday == "ollama" or os.path.isfile(aday):
            exe = aday
            break
    if exe is None:
        print("ollama bulunamadi.", file=sys.stderr)
        return False
    print("ollama servisi kapaliydi, baslatiliyor…", file=sys.stderr)
    try:
        subprocess.Popen([exe, "serve"], stdout=subprocess.DEVNULL,
                         stderr=subprocess.DEVNULL, stdin=subprocess.DEVNULL,
                         creationflags=(subprocess.CREATE_NO_WINDOW
                                        if os.name == "nt" else 0))
    except Exception as exc:  # noqa: BLE001
        print(f"baslatilamadi: {exc}", file=sys.stderr)
        return False
    for _ in range(30):
        time.sleep(1)
        if ayakta_mi():
            return True
    print("servis 30 saniyede acilmadi.", file=sys.stderr)
    return False


def modelleri_getir() -> list[str]:
    try:
        return [m["name"] for m in json.loads(_istek("/api/tags").read())["models"]]
    except Exception:  # noqa: BLE001
        return []


def model_coz(istenen: str, kurulu: list[str]) -> str:
    """Kisayolu gercek ada cevir ve KURULU OLDUGUNU DOGRULA.

    Kurulu olmayan bir modele istek atmak 404 doner ve mesaji anlasilmaz.
    Burada erken durup ne kurulu oldugunu soylemek daha faydali — bu
    ekosistemde opencode config'i tam da bunu yapmiyordu: `qwen2.5-coder:14b`
    istiyordu, kurulu olan 7b'ydi.
    """
    ad = KISAYOL.get(istenen, istenen)
    if ad in kurulu:
        return ad
    # etiketsiz yazilmis olabilir: "llama3.2" -> "llama3.2:latest"
    for k in kurulu:
        if k.split(":")[0] == ad.split(":")[0]:
            return k
    print(f"'{istenen}' kurulu degil. Kurulu modeller:", file=sys.stderr)
    for k in kurulu:
        print(f"  {k}", file=sys.stderr)
    print(f"\nIndirmek icin: ollama pull {ad}", file=sys.stderr)
    sys.exit(2)


def sor(model: str, metin: str, gorseller: list[str], sessiz: bool) -> int:
    govde: dict = {"model": model, "prompt": metin, "stream": True}
    if gorseller:
        kodlu = []
        for y in gorseller:
            if not os.path.isfile(y):
                print(f"gorsel yok: {y}", file=sys.stderr)
                return 2
            with open(y, "rb") as fh:
                kodlu.append(base64.b64encode(fh.read()).decode())
        govde["images"] = kodlu

    if not sessiz:
        ek = f" +{len(gorseller)} gorsel" if gorseller else ""
        print(f"[{model}{ek}]", file=sys.stderr, flush=True)

    try:
        with _istek("/api/generate", govde, zaman=900) as cevap:
            for satir in cevap:
                if not satir.strip():
                    continue
                try:
                    parca = json.loads(satir)
                except json.JSONDecodeError:
                    continue
                if parca.get("error"):
                    print(f"\nhata: {parca['error']}", file=sys.stderr)
                    return 1
                # ISTE BURASI: JSON parcalari birlestirilip DUZ METIN yazilir.
                sys.stdout.write(parca.get("response", ""))
                sys.stdout.flush()
                if parca.get("done"):
                    break
    except urllib.error.HTTPError as e:
        print(f"\nHTTP {e.code}: {e.read().decode('utf-8', 'replace')[:300]}",
              file=sys.stderr)
        return 1
    except KeyboardInterrupt:
        print("\n(kesildi)", file=sys.stderr)
        return 130
    print()
    return 0


def main() -> int:
    ap = argparse.ArgumentParser(
        prog="sor", description="Yerel Ollama'ya sor, duz metin cevap al.")
    ap.add_argument("soru", nargs="*", help="soru metni")
    ap.add_argument("-m", "--model", default=VARSAYILAN,
                    help=f"kisayol ya da tam ad (varsayilan: {VARSAYILAN})")
    ap.add_argument("-g", "--gorsel", action="append", default=[],
                    help="gorsel dosyasi (goren modele gecer)")
    ap.add_argument("--modeller", action="store_true", help="kurulu modelleri listele")
    ap.add_argument("-s", "--sessiz", action="store_true", help="model satirini yazma")
    a = ap.parse_args()

    if not baslat():
        return 3

    kurulu = modelleri_getir()
    if a.modeller:
        print("kurulu modeller:")
        for k in kurulu:
            kisa = [ks for ks, tam in KISAYOL.items() if tam == k]
            print(f"  {k:24}{'  (' + kisa[0] + ')' if kisa else ''}")
        return 0

    metin = " ".join(a.soru).strip()
    # Boru hattindan gelen metin soruya EKLENIR, onun yerine gecmez:
    #   cat hata.log | sor "bu hatanin sebebi ne"
    if not sys.stdin.isatty():
        borudan = sys.stdin.read().strip()
        if borudan:
            metin = f"{metin}\n\n{borudan}" if metin else borudan
    if not metin:
        ap.print_help()
        return 1

    # Gorsel verildiyse GOREN modele gec: oteki modeller `images` alanini
    # sessizce yok sayar ve kullanici "gorseli gormedi" diye sasirir.
    istenen = a.model
    if a.gorsel and KISAYOL.get(istenen, istenen) != KISAYOL["goz"]:
        if not a.sessiz:
            print(f"gorsel verildi -> model '{istenen}' yerine 'goz'",
                  file=sys.stderr)
        istenen = "goz"

    return sor(model_coz(istenen, kurulu), metin, a.gorsel, a.sessiz)


if __name__ == "__main__":
    sys.exit(main())
